# ── RescueNet AI Engine — environment configuration ───────────────────────────
# Copy this file to .env and modify for your local setup.
# The application has sensible defaults — you only need to override what differs.

# ── IBM Granite / Ollama ──────────────────────────────────────────────────────
# Text classification model (already pulled: granite3.3:8b)
GRANITE_MODEL=granite3.3:8b

# Human-readable version for provenance endpoint
GRANITE_MODEL_VERSION=latest

# Base URL of local Ollama server
OLLAMA_HOST=http://localhost:11434

# AI inference timeout in seconds (FR-10)
AI_TIMEOUT_SECONDS=5

# Inference temperature (0 = deterministic, recommended)
AI_TEMPERATURE=0.0

# ── Vision model (Phase 4 — FR-9) ────────────────────────────────────────────
# Recommended: gemma4:latest (already installed — 9.6 GB, vision+audio+tools)
# Alternative: qwen2.5vl:7b  (pull with: ollama pull qwen2.5vl:7b — best-in-class VL)
# Do NOT use: llava:7b  (older arch, 4K context limit, weaker JSON compliance)
#
# Leave empty to auto-detect any installed vision-capable model.
# Set explicitly to lock to a specific model.
VISION_MODEL=gemma4:latest

# ── Severity thresholds ───────────────────────────────────────────────────────
SEVERITY_CRITICAL_THRESHOLD=80
SEVERITY_HIGH_THRESHOLD=60
SEVERITY_MEDIUM_THRESHOLD=40

# ── Application ───────────────────────────────────────────────────────────────
APP_LOG_LEVEL=INFO
APP_ENV=development
