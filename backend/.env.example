# RescueNet AI backend — copy to .env and adjust.
# Every threshold is config-driven on purpose (TRD §9): tuning is an env change,
# never a code change.

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json                 # json | console
CORS_ORIGINS=*                  # comma-separated origins, or * for demo
ENABLE_DEBUG_ROUTES=true        # mounts /api/_debug/* — set false in production

# --- Database ---
DATABASE_URL=sqlite:///./rescuenet.db
DB_ECHO=false

# --- Media storage ---
MEDIA_STORAGE_PATH=./media
MAX_IMAGE_BYTES=10485760        # 10 MiB
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# --- ResQ AI engine (IBM Granite via Ollama, in-process) ---
AI_ENGINE_ENABLED=false         # true once Ollama is running with the model pulled
AI_ENGINE_PATH=../ai-engine
AI_ENGINE_TIMEOUT_SECONDS=20    # NOT 5 — Granite 8B needs ~15s on CPU
OLLAMA_HOST=http://localhost:11434
GRANITE_MODEL=granite3.3:8b

# Two-pass scoring. The rule scorer always runs first (~1ms) so nothing waits
# on the LLM; Granite re-scores only where it can change the outcome.
AI_ESCALATE_ON_OTHER=true       # rules did not understand the text (e.g. non-English)
AI_ESCALATE_NEAR_BAND=true      # score sits near a band boundary an operator acts on
AI_ESCALATE_BAND_MARGIN=5
AI_ESCALATE_TOP_N=10            # spend inference on what is about to be dispatched

# --- AI providers (Phase 4) ---
# The chain is tried in order; 'local' is the deterministic floor and is always
# appended if omitted, so the API still scores with zero network access (NFR-2).
AI_PROVIDER_ORDER=gemini,groq,local
GEMINI_API_KEY=
GROQ_API_KEY=
AI_TIMEOUT_SECONDS=4
AI_RETRY_ATTEMPTS=1             # retries per provider, after the first attempt
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile

# --- Authenticity thresholds (Phase 5) ---
AUTHENTICITY_BASELINE=60        # every report starts here, then signals adjust it
AUTHENTICITY_FLAG_THRESHOLD=40  # below this a report is flagged for human review
PHASH_DUPLICATE_DISTANCE=8      # max Hamming distance counted as a duplicate image
CORROBORATION_RADIUS_M=500
CORROBORATION_WINDOW_MIN=30
CORROBORATION_MIN_REPORTS=2         # cluster size, including the report being scored
CORROBORATION_REQUIRE_SAME_TYPE=true # FR-14 says "the same event", not merely nearby
STALE_REPORT_HOURS=6
IMPOSSIBLE_MOVEMENT_KM=100
IMPOSSIBLE_MOVEMENT_WINDOW_MIN=10
EXIF_MATCH_RADIUS_KM=1
LOW_INFORMATION_MAX_TOKENS=5

# --- Priority queue (Phase 6) ---
# priority = severity*w1 + authenticity*w2 + ageing_bonus*w3
PRIORITY_WEIGHT_SEVERITY=0.70
PRIORITY_WEIGHT_AUTHENTICITY=0.15
PRIORITY_WEIGHT_AGEING=0.15
AGEING_RATE_PER_MINUTE=1.5      # bonus points per minute waited (client clock)
AGEING_MAX_BONUS=100            # reached after ~67 min; caps how far ageing can lift a report

# --- Dispatch (Phase 7) ---
# match_score = distance*w1 + skill*w2 + load*w3, among available in-range responders
DISPATCH_MAX_RADIUS_KM=25
DISPATCH_WEIGHT_DISTANCE=0.5
DISPATCH_WEIGHT_SKILL=0.3
DISPATCH_WEIGHT_LOAD=0.2

# --- Process mining (Phase 9) ---
BOTTLENECK_DEVIATION_RATIO=1.5

# --- Offline sync (Phase 10) ---
SYNC_MAX_BATCH_SIZE=200
