# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Environment
.env

# Database (demo data is regenerated by seed/seed.py)
*.db
*.db-wal
*.db-shm

# Uploaded media — keep the directory, ignore its contents.
# (Must glob the contents: git cannot re-include a file inside an excluded directory.)
backend/media/*
!backend/media/.gitkeep

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store
